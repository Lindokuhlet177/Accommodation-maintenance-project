@model List<Staff>
@{
    var shell = ViewData["Shell"] as ShellModel ?? new ShellModel();
    var pending = Model.Count(c => !c.IsApproved);
}

<div class="reg-head">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Back to Tenants</a>
        <h2 class="section-title" style="margin-top:10px">Caretakers</h2>
        <p class="section-subtitle">
            Caretakers sign up on the website and wait here until you approve them.
            They only see requests for the building you choose.
        </p>
    </div>
    <span class="pending-pill"><span class="bell-dot-static"></span> @pending pending</span>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty">No caretakers have signed up yet</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr><th>Name</th><th>Email</th><th>Building</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var formId = $"approve-{c.Id}";
                        <tr>
                            <td>
                                <div class="issue">
                                    <span class="avatar small">@AppClaims.Initials(c.Name)</span>
                                    <strong>@c.Name</strong>
                                </div>
                            </td>
                            <td class="muted">@c.Email</td>
                            <td>
                                <!-- Building choice: confirms or changes where they work -->
                                <form asp-action="ApproveCaretaker" method="post" id="@formId" style="margin:0">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <select name="accommodationId" class="form-input compact">
                                        @foreach (var p in shell.Properties)
                                        {
                                            <option value="@p.Id" selected="@(c.AccommodationId == p.Id)">@p.Name</option>
                                        }
                                    </select>
                                </form>
                            </td>
                            <td>
                                @if (c.IsApproved)
                                {
                                    <span class="chip closed">Approved</span>
                                }
                                else
                                {
                                    <span class="chip completed">Pending</span>
                                }
                            </td>
                            <td>
                                <div class="reg-actions">
                                    @if (c.IsApproved)
                                    {
                                        <button type="submit" form="@formId" class="btn btn-outline">Save</button>
                                        <form asp-action="RevokeCaretaker" method="post"
                                              onsubmit="return confirm('Remove @c.Name\'s access?');">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="btn btn-danger-outline">Remove access</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="submit" form="@formId" class="btn btn-success">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </button>
                                        <form asp-action="RejectCaretaker" method="post"
                                              onsubmit="return confirm('Reject @c.Name? Their sign-up will be removed.');">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="btn btn-danger-outline">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>