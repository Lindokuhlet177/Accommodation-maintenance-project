@model TenantForm

<div class="card form-card">
    <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Back to Tenants</a>
    <h2 class="card-title" style="margin-top:12px">Add a tenant</h2>
    <p class="card-subtitle">
        Enter the details from the signed contract. When the student signs up in the app with the same
        student number and surname, they're linked to this room automatically.
    </p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert error"></div>

        <div class="form-row">
            <div>
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-input" placeholder="e.g. Thandi" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Surname" class="form-label"></label>
                <input asp-for="Surname" class="form-input" placeholder="e.g. Nkosi" />
                <span asp-validation-for="Surname" class="field-error"></span>
            </div>
        </div>

        <label asp-for="StudentNumber" class="form-label"></label>
        <input asp-for="StudentNumber" class="form-input" placeholder="e.g. 222071197" />
        <span asp-validation-for="StudentNumber" class="field-error"></span>

        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-input" placeholder="e.g. thandi@stud.cut.ac.za" />
        <span asp-validation-for="Email" class="field-error"></span>

        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-input" placeholder="e.g. 082 123 4567" />
        <span asp-validation-for="Phone" class="field-error"></span>

        <label asp-for="RoomId" class="form-label"></label>
        <select asp-for="RoomId" class="form-input">
            <option value="">Choose a room</option>
            @foreach (var r in Model.RoomChoices)
            {
                <option value="@r.Room.Id" disabled="@r.IsOccupied">
                    @r.Room.RoomNumber · @r.Room.FloorText · @r.Room.RoomType
                    (@(r.IsOccupied ? "full" : $"{r.Room.Capacity - r.Tenants.Count} bed(s) free"))
                </option>
            }
        </select>
        <span asp-validation-for="RoomId" class="field-error"></span>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline-grey" style="width:auto">Cancel</a>
            <button type="submit" class="btn btn-primary">Add Tenant</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}