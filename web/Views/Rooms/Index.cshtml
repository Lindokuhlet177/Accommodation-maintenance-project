@model RoomListViewModel

<div class="card">
    <!-- Search, floor filter, Add Room -->
    <form method="get" asp-action="Index" class="toolbar">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="search" name="search" value="@Model.Search" placeholder="Search by room number"
                   autocomplete="off" />
        </div>
        <select name="floor" class="filter-select" onchange="this.form.submit()">
            <option value="">All Floors</option>
            @foreach (var f in Model.Floors)
            {
                <option value="@f" selected="@(Model.Floor == f)">Floor @f</option>
            }
        </select>
        <a asp-action="Create" class="btn btn-primary toolbar-button">+ Add Room</a>
    </form>

    @if (Model.Rows.Count == 0)
    {
        <div class="empty">
            @(Model.TotalRooms == 0 ? "No rooms yet. Add the first one." : "No rooms match your search")
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Room Number</th>
                        <th>Floor</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Current Tenant</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>
                                <div class="issue">
                                    <span class="issue-icon cat-blue"><i class="bi bi-door-closed"></i></span>
                                    <strong>@row.Room.RoomNumber</strong>
                                </div>
                            </td>
                            <td>@row.Room.FloorText</td>
                            <td>@row.Room.RoomType</td>
                            <td>
                                <span class="chip @(row.IsOccupied ? "occupied" : "available")">@row.StatusText</span>
                                @if (row.Room.Capacity > 1)
                                {
                                    <span class="muted small-text">@row.Tenants.Count of @row.Room.Capacity</span>
                                }
                            </td>
                            <td>@row.TenantText</td>
                            <td><a asp-action="Details" asp-route-id="@row.Room.Id" class="chip open">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted small-text table-count">Showing @Model.Rows.Count of @Model.TotalRooms rooms</p>
    }
</div>