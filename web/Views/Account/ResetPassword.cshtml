@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Choose a new password";
}

<div class="auth-page">
    <aside class="auth-strip">
        <img src="~/images/logo.png" alt="StudentStayFix" class="auth-logo" />
    </aside>

    <main class="auth-main">
        <div class="auth-card">
            <p class="auth-eyebrow">FORGOT PASSWORD</p>
            <h1 class="auth-title">Choose a new password</h1>
            <p class="auth-subtitle">Enter the code we emailed you, then your new password.</p>

            @if (TempData["Success"] is string success)
            {
                <div class="auth-alert success">@success</div>
            }

            <form asp-action="ResetPassword" method="post" id="reset-form">
                <div asp-validation-summary="ModelOnly" class="auth-alert error"></div>

                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="auth-input" autocomplete="email" />
                <span asp-validation-for="Email" class="auth-field-error"></span>

                <label asp-for="Code" class="auth-label"></label>
                <input asp-for="Code" class="auth-input" placeholder="e.g. 123456"
                       inputmode="numeric" autocomplete="one-time-code" />
                <span asp-validation-for="Code" class="auth-field-error"></span>

                <label asp-for="Password" class="auth-label"></label>
                <input asp-for="Password" class="auth-input" placeholder="At least 6 characters"
                       autocomplete="new-password" />
                <span asp-validation-for="Password" class="auth-field-error"></span>

                <label asp-for="ConfirmPassword" class="auth-label"></label>
                <input asp-for="ConfirmPassword" class="auth-input" placeholder="Type it again"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>

                <button type="submit" class="auth-button" id="reset-button">Change password</button>
            </form>

            <p class="auth-footer">
                No code? <a asp-action="ForgotPassword" class="auth-link">Send a new one</a>
            </p>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#reset-form').on('submit', function () {
            if ($(this).valid()) $('#reset-button').prop('disabled', true).text('Saving…');
        });
    </script>
}