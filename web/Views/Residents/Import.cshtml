@{
    var shell = ViewData["Shell"] as ShellModel ?? new ShellModel();
}

<div class="card form-card import-card">
    <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Back to Tenants</a>
    <h2 class="card-title" style="margin-top:12px">Import a list of tenants</h2>
    <p class="card-subtitle">
        Students on the list are linked to their room automatically when they sign up in the app
        with the same student number and surname. The list is added to <strong>@shell.Current?.Name</strong>.
    </p>

    @if (ViewData["ImportError"] is string error)
    {
        <div class="alert error" style="margin-top:16px"><i class="bi bi-exclamation-circle-fill"></i> @error</div>
    }

    <ol class="import-steps">
        <li>
            <strong>Download the template</strong>
            <span>Columns: name, surname, student_number, room_number, email (optional), phone (optional).</span>
            <a asp-action="ImportTemplate" class="btn btn-outline" style="margin-top:8px">
                <i class="bi bi-download"></i> Download template
            </a>
        </li>
        <li>
            <strong>Fill it in Excel or Google Sheets</strong>
            <span>
                One student per row. Room numbers must match the rooms on the Rooms page.
                Tip: format the phone column as <em>Text</em> so Excel keeps the leading 0.
            </span>
        </li>
        <li>
            <strong>Save as CSV and upload it</strong>
            <span>Excel: File → Save As → CSV. You'll see a preview before anything is saved.</span>
            <form asp-action="Import" method="post" enctype="multipart/form-data" class="upload-form">
                <input type="file" name="file" accept=".csv" required class="form-input" />
                <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Upload and check</button>
            </form>
        </li>
    </ol>
</div>