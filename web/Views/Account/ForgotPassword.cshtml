@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<div class="auth-page">
    <aside class="auth-strip">
        <img src="~/images/logo.png" alt="StudentStayFix" class="auth-logo" />
    </aside>

    <main class="auth-main">
        <div class="auth-card">
            <p class="auth-eyebrow">FORGOT PASSWORD</p>
            <h1 class="auth-title">Reset your password</h1>
            <p class="auth-subtitle">Enter your email and we'll send you a code to choose a new password.</p>

            <form asp-action="ForgotPassword" method="post" id="forgot-form">
                <div asp-validation-summary="ModelOnly" class="auth-alert error"></div>

                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="auth-input" placeholder="Enter your email" autocomplete="email" />
                <span asp-validation-for="Email" class="auth-field-error"></span>

                <button type="submit" class="auth-button" id="forgot-button">Send code</button>
            </form>

            <p class="auth-footer">
                Remembered it? <a asp-action="Login" class="auth-link">Back to Sign In</a>
            </p>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#forgot-form').on('submit', function () {
            if ($(this).valid()) $('#forgot-button').prop('disabled', true).text('Sending…');
        });
    </script>
}