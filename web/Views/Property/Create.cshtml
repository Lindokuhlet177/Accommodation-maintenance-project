@model PropertyForm

<div class="card form-card">
    <a asp-controller="Dashboard" asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Back to Overview</a>
    <h2 class="card-title" style="margin-top:12px">Add a property</h2>
    <p class="card-subtitle">
        After adding it, you'll add its rooms, then its tenants (one by one or by importing a list).
    </p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert error"></div>

        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-input" placeholder="e.g. Omega Court" />
        <span asp-validation-for="Name" class="field-error"></span>

        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-input" placeholder="e.g. 24 King Edward Road, Bloemfontein" />
        <span asp-validation-for="Address" class="field-error"></span>

        <div class="form-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-grey" style="width:auto">Cancel</a>
            <button type="submit" class="btn btn-primary">Add Property</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}