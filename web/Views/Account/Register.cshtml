@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Caretaker sign-up";
}

<div class="auth-page">
    <aside class="auth-strip">
        <img src="~/images/logo.png" alt="StudentStayFix" class="auth-logo" />
    </aside>

    <main class="auth-main">
        <div class="auth-card">
            <p class="auth-eyebrow">CARETAKERS</p>
            <h1 class="auth-title">Create your account</h1>
            <p class="auth-subtitle">The landlord will approve your account before you can sign in.</p>

            <form asp-action="Register" method="post" id="register-form">
                <div asp-validation-summary="ModelOnly" class="auth-alert error"></div>

                <label asp-for="Name" class="auth-label"></label>
                <input asp-for="Name" class="auth-input" placeholder="e.g. Sipho Dlamini"
                       autocomplete="name" />
                <span asp-validation-for="Name" class="auth-field-error"></span>

                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="auth-input" placeholder="Enter your email"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="auth-field-error"></span>

                <label asp-for="AccommodationId" class="auth-label"></label>
                <select asp-for="AccommodationId" class="auth-input"
                        asp-items="@(new SelectList(Model.Accommodations, "Id", "Name"))">
                    <option value="">Select the accommodation you work at</option>
                </select>
                <span asp-validation-for="AccommodationId" class="auth-field-error"></span>

                <label asp-for="Password" class="auth-label"></label>
                <input asp-for="Password" class="auth-input" placeholder="At least 6 characters"
                       autocomplete="new-password" />
                <span asp-validation-for="Password" class="auth-field-error"></span>

                <label asp-for="ConfirmPassword" class="auth-label"></label>
                <input asp-for="ConfirmPassword" class="auth-input" placeholder="Type it again"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>

                <button type="submit" class="auth-button" id="register-button">Create account</button>
            </form>

            <p class="auth-footer">
                Already have an account? <a asp-action="Login" class="auth-link">Sign in</a>
            </p>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#register-form').on('submit', function () {
            if ($(this).valid()) {
                $('#register-button').prop('disabled', true).text('Creating account…');
            }
        });
    </script>
}